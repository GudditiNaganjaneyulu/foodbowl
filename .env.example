# ── Database ────────────────────────────────────────────────────────────────
# Local docker-compose postgres by default. Swap for a NeonDB connection string
# (from your Neon project's free-tier dashboard) to point the same code at the
# cloud DB — no code changes required.
DATABASE_URL=postgresql://foodbowl:foodbowl@localhost:5432/foodbowl

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-dev-only
JWT_REFRESH_SECRET=change-me-dev-only-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── Supabase Storage (free tier — storage only, no Supabase Auth/DB) ────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_MENU=menu-images
SUPABASE_STORAGE_BUCKET_ASSETS=restaurant-assets
SUPABASE_STORAGE_BUCKET_PROOFS=delivery-proofs
SUPABASE_STORAGE_BUCKET_AVATARS=user-avatars

# ── Observability (self-hosted, free) ────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=foodbowl-api
LOG_LEVEL=info

# ── Email (dev: Mailpit, free/local) ─────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=orders@foodbowl.local

# ── API ───────────────────────────────────────────────────────────────────
PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# ── Web (Next.js — must be prefixed NEXT_PUBLIC_ to reach the browser) ──────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
