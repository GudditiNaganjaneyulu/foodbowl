# ── Database ────────────────────────────────────────────────────────────────
# Direct NeonDB connection (free tier — get this from your Neon project
# dashboard: Connection Details, pooled connection string). Local
# docker-compose Postgres is commented out in infra/docker-compose.yml in
# favor of connecting straight to Neon from every environment.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/foodbowl?sslmode=require&channel_binding=require

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-dev-only
JWT_REFRESH_SECRET=change-me-dev-only-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── Supabase Storage (free tier — storage only, no Supabase Auth/DB) ────────
# Photos (menu, delivery proof, avatars) live in Supabase Storage. The buckets
# below must exist and be PUBLIC-read. Without SUPABASE_URL/KEY the API falls back
# to built-in storage on its own disk (UPLOAD_DIR) so uploads still work.
# (Bucket names are fixed in packages/shared for now; these vars document them.)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_MENU=menu-images
SUPABASE_STORAGE_BUCKET_ASSETS=restaurant-assets
SUPABASE_STORAGE_BUCKET_PROOFS=delivery-proofs
SUPABASE_STORAGE_BUCKET_AVATARS=user-avatars

# ── Observability ─────────────────────────────────────────────────────────
# apps/api always talks to the local otel-collector (see docker-compose.yml) —
# it never exports to Grafana Cloud directly. The collector is the one that
# forwards to Grafana Cloud, using the three GRAFANA_CLOUD_* vars below.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=foodbowl-api
LOG_LEVEL=info

# Grafana Cloud free tier (traces + metrics), consumed by the otel-collector
# container, not by apps/api. From Grafana Cloud → your stack → "Configure" ->
# OpenTelemetry: OTLP endpoint, the numeric "Instance ID" (username), and a
# generated API token (password) scoped to metrics+traces write.
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=

# ── Email (Brevo free tier — 300 emails/day, no card required) ──────────────
# SMTP & API > SMTP tab in Brevo: login is your account email, password is
# the generated "SMTP key" (not your account password). SMTP_FROM must be a
# verified sender in Brevo. Swap back to localhost:1025 (no auth) to use the
# local Mailpit container in docker-compose instead.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=orders@foodbowl.local
# Real emails are opt-in, so a dev machine with live Brevo credentials never mails
# the seeded demo accounts. In-app notifications work regardless.
EMAIL_NOTIFICATIONS_ENABLED=false

# ── API ───────────────────────────────────────────────────────────────────
PORT=4000
# Built-in file storage (only used when Supabase isn't configured). In Docker, mount a
# volume here or uploaded files vanish on redeploy. PUBLIC_API_URL is this API's address
# as browsers see it — only needed behind a reverse proxy.
# UPLOAD_DIR=./uploads
# PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# ── Web (Next.js — must be prefixed NEXT_PUBLIC_ to reach the browser) ──────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ── Redis (Upstash, free tier) — auth rate limiting + menu response caching ──
# Optional: the app boots and works fine without these set (rate limiting and
# caching just no-op). @upstash/redis is an HTTP/REST client — get BOTH vars
# from the Upstash console → your database → REST API tab (it shows a
# ready-to-paste "@upstash/redis" env snippet with exactly these two names).
# A rediss://... TCP connection string is a different credential and won't
# work here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=