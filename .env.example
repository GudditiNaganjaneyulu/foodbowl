# ── Database ────────────────────────────────────────────────────────────────
# Direct NeonDB connection (free tier — get this from your Neon project
# dashboard: Connection Details, pooled connection string). Local
# docker-compose Postgres is commented out in infra/docker-compose.yml in
# favor of connecting straight to Neon from every environment.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/foodbowl?sslmode=require&channel_binding=require

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-dev-only
JWT_REFRESH_SECRET=change-me-dev-only-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── Supabase Storage (free tier — storage only, no Supabase Auth/DB) ────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_MENU=menu-images
SUPABASE_STORAGE_BUCKET_ASSETS=restaurant-assets
SUPABASE_STORAGE_BUCKET_PROOFS=delivery-proofs
SUPABASE_STORAGE_BUCKET_AVATARS=user-avatars

# ── Observability (self-hosted, free) ────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=foodbowl-api
LOG_LEVEL=info

# ── Email (Brevo free tier — 300 emails/day, no card required) ──────────────
# SMTP & API > SMTP tab in Brevo: login is your account email, password is
# the generated "SMTP key" (not your account password). SMTP_FROM must be a
# verified sender in Brevo. Swap back to localhost:1025 (no auth) to use the
# local Mailpit container in docker-compose instead.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=orders@foodbowl.local

# ── API ───────────────────────────────────────────────────────────────────
PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# ── Web (Next.js — must be prefixed NEXT_PUBLIC_ to reach the browser) ──────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000



