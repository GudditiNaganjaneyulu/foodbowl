{
  "name": "foodbowl",
  "private": true,
  "version": "0.1.0",
  "description": "Single-restaurant food ordering platform — monorepo (API, web, shared packages).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter=./apps/* dev",
    "dev:api": "pnpm --filter @foodbowl/api dev",
    "dev:web": "pnpm --filter @foodbowl/web dev",
    "build": "pnpm --filter=./packages/* build && pnpm --filter=./apps/* build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @foodbowl/api db:generate",
    "db:migrate": "pnpm --filter @foodbowl/api db:migrate",
    "db:seed": "pnpm --filter @foodbowl/api db:seed",
    "db:studio": "pnpm --filter @foodbowl/api db:studio",
    "docker:up": "docker compose -f infra/docker-compose.yml up --build",
    "docker:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.15.4"
}
